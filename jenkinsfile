pipeline {
    agent any
    
    environment {
        REGISTRY_URL = '10.1.0.118:443'
        REGISTRY_USER = 'theroad'
        IMAGE_NAME = 'jenkins-test'
    }
    
    stages {
        stage('Clone') {
            steps {
                echo 'Cloning repository...'
                git branch: 'main',
                    credentialsId: 'jenkinsgit',
                    url: 'https://github.com/Jaeun-Choi98/jenkins-test'
            }
        }
        
        stage('Docker Login') {
            steps {
                echo 'Docker login...'
                script {
                    withCredentials([
                        string(credentialsId: 'docker-registry-password', variable: 'DOCKER_PWD')
                    ]) {
                        sh """
                        echo \${DOCKER_PWD} | docker login \${REGISTRY_URL} -u \${REGISTRY_USER} --password-stdin
                        """
                    }
                }
                echo 'Login successful'
            }
        }
        
        stage('Build') {
            steps {
                echo 'Building image...'
                sh """
                docker build -t \${REGISTRY_URL}/\${IMAGE_NAME}:\${BUILD_NUMBER} .
                """
                echo 'Build complete'
            }
        }
        
        stage('Verify') {
            steps {
                echo 'Verifying image...'
                sh """
                docker images | grep \${IMAGE_NAME}
                """
            }
        }
        
        stage('Push') {
          steps {
            echo 'Pushing image...'
            sh """
            docker push \${REGISTRY_URL}/\${IMAGE_NAME}:\${BUILD_NUMBER}
            """
            echo 'Push complete'
          }
        }

        stage('Run Container') {
          steps{
           echo 'Running Container...'
           sh """
           docker stop \$(docker ps -aqf "name=jenkinstest") || true
           docker rm \$(docker ps -aqf "name=jenkinstest") || true
           """

           sh """
           docker run -d -e TZ="Asia/Seoul" -p 8088:8088 --name jenkinstest \${REGISTRY_URL}/\${IMAGE_NAME}:\${BUILD_NUMBER}
           """    
          }
        }
    }
    
    post {
        always {
            sh """
            docker logout \${REGISTRY_URL} || true
            """
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}